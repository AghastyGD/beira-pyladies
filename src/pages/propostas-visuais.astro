---
import BaseLayout from '../layouts/BaseLayout.astro';

const upcomingEvents = [
  {
    day: '14',
    month: 'JUN',
    title: 'Python para iniciantes',
    label: 'Workshop aberto',
    location: 'Beira Creative Hub',
  },
  {
    day: '28',
    month: 'JUN',
    title: 'Office hours da comunidade',
    label: 'Mentoria',
    location: 'Online + Beira',
  },
  {
    day: '12',
    month: 'JUL',
    title: 'Django para produtos locais',
    label: 'Hands-on',
    location: 'Hub universitario',
  },
];

const pastEvents = [
  {
    title: 'Introducao ao Django',
    note: 'Fotos do encontro e materiais',
    tone: 'hero',
  },
  {
    title: 'Python basics meetup',
    note: 'Galeria e resumo',
    tone: 'sand',
  },
  {
    title: 'Sessao de carreira',
    note: 'Falamos sobre trilhas e networking',
    tone: 'blue',
  },
  {
    title: 'Community day',
    note: 'Encontro de partilha e acolhimento',
    tone: 'rose',
  },
  {
    title: 'Mini bootcamp',
    note: 'Atividades praticas e mentoria',
    tone: 'olive',
  },
];

const organizers = [
  {
    name: 'Amina Celina',
    role: 'Tech Lead',
    bio: 'Coordena as trilhas tecnicas, os workshops e os materiais de estudo da comunidade.',
    socials: ['GitHub', 'LinkedIn', 'Email'],
    tone: 'one',
  },
  {
    name: 'Fatima Ernesto',
    role: 'General Manager',
    bio: 'Cuida da agenda, das parcerias e da operacao para que os encontros acontecam com constancia.',
    socials: ['LinkedIn', 'Instagram'],
    tone: 'two',
  },
  {
    name: 'Sofia Macuacua',
    role: 'Community Lead',
    bio: 'Acompanha novas participantes, moderacao da comunidade e iniciativas de acolhimento.',
    socials: ['Instagram', 'WhatsApp', 'Email'],
    tone: 'three',
  },
];

const faq = [
  {
    question: 'Como participar dos encontros?',
    answer:
      'A home pode levar para uma pagina de eventos com inscricao simples, informando formato, local, publico e materiais.',
    open: true,
  },
  {
    question: 'Os eventos precisam sempre ter foto?',
    answer:
      'Nao. Proximos eventos podem ser cards limpos. As fotos entram principalmente nos eventos passados e na hero, onde elas ajudam a dar prova social.',
    open: false,
  },
  {
    question: 'Como mostrar as organizadoras?',
    answer:
      'Com foto circular, cargo, mini bio e links sociais. Isso passa mais confianca do que um bloco generico de texto.',
    open: false,
  },
  {
    question: 'O site precisa de FAQ e recursos?',
    answer:
      'Sim. Isso ajuda a transformar a home em um ponto de entrada completo para novas participantes, parcerias e quem quer acompanhar a comunidade.',
    open: false,
  },
];

const resources = [
  {
    title: 'Instagram',
    description: 'Agenda, bastidores e anuncios da comunidade.',
    action: '@pyladiesbeira',
  },
  {
    title: 'Grupo de comunidade',
    description: 'Canal para avisos, partilha e proximos encontros.',
    action: 'Entrar no grupo',
  },
  {
    title: 'Repositorio',
    description: 'Materiais, links e apoio para quem esta comecando.',
    action: 'Ver recursos',
  },
  {
    title: 'Parcerias',
    description: 'Canal para apoio institucional, espacos e colaboracoes.',
    action: 'Falar com a equipe',
  },
];

const heroSlides = [
  'Workshop de Python',
  'Meetup da comunidade',
  'Dia de mentoria',
];
---

<BaseLayout title="PyLadies Beira" description="Comunidade de mulheres que aprendem, compartilham e crescem com Python na cidade da Beira.">
  <div class="proposal-site">
    <header class="site-header">
      <a class="site-brand" href="#inicio">
        <span class="site-brand__mark">PB</span>
        <span>PyLadies Beira</span>
      </a>

      <nav class="site-nav" aria-label="Navegacao da proposta">
        <a href="#sobre">Sobre</a>
        <a href="#eventos">Eventos</a>
        <a href="#organizadoras">Organizadoras</a>
        <a href="#faq">FAQ</a>
        <a href="#recursos">Recursos</a>
      </nav>

      <a class="site-cta" href="#recursos">Participar</a>
    </header>

    <main class="site-main" id="inicio">
      <section class="hero-section">
        <div class="hero-copy">
          <p class="eyebrow">Comunidade Python em Beira, Mocambique</p>
          <h1>Aprender, partilhar e crescer com Python em comunidade.</h1>
          <p class="hero-copy__lead">
            Workshops, encontros, mentorias e partilha para mulheres em tecnologia na cidade da Beira.
          </p>

          <div class="hero-actions">
            <a class="button button--solid" href="#eventos">Ver eventos</a>
            <a class="button button--ghost" href="#organizadoras">Conhecer a equipe</a>
          </div>

          <div class="hero-meta">
            <div>
              <span class="hero-meta__label">Comunidade</span>
              <strong>Encontros locais e acolhimento</strong>
            </div>
            <div>
              <span class="hero-meta__label">Formato</span>
              <strong>Workshops, talks e mentorias</strong>
            </div>
          </div>
        </div>

        <div class="hero-media">
          <article class="hero-frame">
            <div class="hero-frame__overlay">
              <p class="eyebrow eyebrow--light">Proximo destaque</p>
              <h2>Uma comunidade local para entrar, aprender e voltar sempre.</h2>
              <p>
                Acompanhe os proximos encontros e veja o que ja aconteceu com a comunidade PyLadies Beira.
              </p>
            </div>
          </article>

          <div class="hero-rail">
            {heroSlides.map((slide, index) => (
              <article class={`hero-thumb hero-thumb--${index + 1}`}>
                <div class="hero-thumb__image"></div>
                <div class="hero-thumb__copy">
                  <span>{`0${index + 1}`}</span>
                  <strong>{slide}</strong>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="about-section" id="sobre">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Sobre a comunidade</p>
            <h2>Um espaco para mulheres aprenderem Python com apoio e continuidade.</h2>
          </div>

          <p class="section-intro">
            PyLadies Beira promove encontros, troca de experiencia e acesso a uma rede local de aprendizagem em tecnologia.
          </p>
        </div>

        <div class="about-grid">
          <article class="about-card about-card--story">
            <h3>Aprendizagem com acolhimento</h3>
            <p>
              Criamos um ambiente para estudar, perguntar, praticar e construir conexoes com outras mulheres na tecnologia.
            </p>
          </article>

          <article class="about-card about-card--facts">
            <div>
              <span class="about-card__label">Atividades</span>
              <strong>Workshops, meetups e sessoes praticas</strong>
            </div>
            <div>
              <span class="about-card__label">Comunidade</span>
              <strong>Rede local para aprender e partilhar</strong>
            </div>
            <div>
              <span class="about-card__label">Participacao</span>
              <strong>Eventos, recursos e contato direto com a equipe</strong>
            </div>
          </article>
        </div>
      </section>

      <section class="events-section" id="eventos">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Agenda</p>
            <h2>Proximos encontros da comunidade.</h2>
          </div>
          <a class="section-link" href="#recursos">Ver calendario completo</a>
        </div>

        <div class="upcoming-grid">
          {upcomingEvents.map((event) => (
            <article class="event-card">
              <div class="event-card__date">
                <span>{event.month}</span>
                <strong>{event.day}</strong>
              </div>

              <div class="event-card__body">
                <p class="event-card__label">{event.label}</p>
                <h3>{event.title}</h3>
                <p>{event.location}</p>
                <a href="#recursos">Inscrever-se</a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="gallery-section">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Eventos passados</p>
            <h2>Momentos que marcaram a comunidade.</h2>
          </div>

          <p class="section-intro">
            Fotos, resumos e materiais para registrar a memoria dos encontros e inspirar novas participantes.
          </p>
        </div>

        <div class="gallery-grid">
          {pastEvents.map((event, index) => (
            <article class={`past-card past-card--${event.tone} ${index === 0 ? 'past-card--featured' : ''}`}>
              <div class="past-card__media"></div>
              <div class="past-card__body">
                <strong>{event.title}</strong>
                <span>{event.note}</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="team-section" id="organizadoras">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">Organizadoras</p>
            <h2>As pessoas que fazem a comunidade acontecer.</h2>
          </div>

          <p class="section-intro">
            Conheca a equipe que coordena atividades, acolhe novas participantes e move a comunidade na cidade da Beira.
          </p>
        </div>

        <div class="team-grid">
          {organizers.map((person) => (
            <article class="person-card">
              <div class={`person-card__avatar person-card__avatar--${person.tone}`}></div>

              <div class="person-card__body">
                <span class="person-card__role">{person.role}</span>
                <h3>{person.name}</h3>
                <p>{person.bio}</p>

                <div class="person-card__socials">
                  {person.socials.map((social) => (
                    <span>{social}</span>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="faq-section" id="faq">
        <div class="section-heading section-heading--split">
          <div>
            <p class="eyebrow">FAQ</p>
            <h2>Perguntas frequentes para quem quer participar.</h2>
          </div>

          <p class="section-intro">
            Tudo o que precisa de saber para acompanhar os encontros, entrar na comunidade e comecar a participar.
          </p>
        </div>

        <div class="faq-list">
          {faq.map((item) => (
            <details class="faq-item" open={item.open}>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="resources-section" id="recursos">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Recursos e contato</p>
            <h2>Canais para acompanhar, aprender e entrar em contato.</h2>
          </div>
          <a class="section-link" href="#inicio">Voltar ao topo</a>
        </div>

        <div class="resource-grid">
          {resources.map((resource) => (
            <article class="resource-card">
              <h3>{resource.title}</h3>
              <p>{resource.description}</p>
              <span>{resource.action}</span>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div>
        <strong>PyLadies Beira</strong>
        <p>Comunidade local para mulheres que querem aprender, praticar e crescer com Python.</p>
      </div>

      <div class="site-footer__links">
        <a href="#sobre">Sobre</a>
        <a href="#eventos">Eventos</a>
        <a href="#organizadoras">Organizadoras</a>
        <a href="#recursos">Contato</a>
      </div>
    </footer>
  </div>

 <style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at top left, rgba(214, 29, 93, 0.08), transparent 28%),
      linear-gradient(180deg, #f6f3ee 0%, #f4f0ea 100%);
    color: #1f1b17;
  }

  .proposal-site {
    --bg: #f6f3ee;
    --surface: rgba(255, 255, 255, 0.82);
    --surface-strong: #ffffff;
    --surface-soft: #f0e8df;
    --ink: #1f1b17;
    --muted: #6b6259;
    --border: rgba(31, 27, 23, 0.08);
    --brand: #d61d5d;
    --brand-dark: #aa1447;
    --accent: #1f6b74;

    width: 100%;
    max-width: 1800px;

    margin: 0 auto;

    padding-inline: clamp(24px, 5vw, 96px);
    padding-bottom: 5rem;

    font-family: 'Avenir Next', 'Fira Sans', 'Segoe UI', sans-serif;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;

    padding:
      1rem
      clamp(1rem, 2vw, 2rem);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    background: rgba(255,255,255,.88);

    backdrop-filter: blur(18px);

    border-bottom:
      1px solid var(--border);
  }

  .site-brand,
  .site-nav a,
  .site-cta,
  .button,
  .section-link,
  .site-footer__links a {
    text-decoration: none;
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: .8rem;

    color: var(--ink);

    font-weight: 800;
  }

  .site-brand__mark {
    width: 2.35rem;
    height: 2.35rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: var(--brand);

    color: white;

    font-size: .92rem;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
  }

  .site-nav a,
  .site-footer__links a {
    color: var(--muted);

    font-size: .95rem;
    font-weight: 700;
  }

  .site-cta,
  .button,
  .section-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: .5rem;

    padding:
      .9rem
      1.2rem;

    border-radius: 16px;

    font-weight: 700;

    border:
      1px solid transparent;

    transition:
      transform .2s ease,
      opacity .2s ease;
  }

  .site-cta:hover,
  .button:hover {
    transform: translateY(-2px);
  }

  .site-cta,
  .button--solid {
    background: var(--brand);
    border-color: var(--brand);
    color: white;
  }

  .button--ghost,
  .section-link {
    background: rgba(255,255,255,.7);
    border-color: var(--border);
    color: var(--ink);
  }

  .site-main {
    display: grid;
    gap: 8rem;
    padding-top: 0;
  }

  .hero-section,
  .about-grid,
  .section-heading--split,
  .team-grid {
    display: grid;
    gap: 2rem;
  }

  .hero-section {
    min-height: calc(100svh - 6rem);

    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(420px, .78fr);

    align-items: center;

    gap: clamp(2rem, 4vw, 5rem);

    padding:
      4rem
      0
      3rem;

    scroll-margin-top: 7rem;
  }

  .hero-copy {
    display: grid;
    align-content: center;

    min-height: 100%;
  }

  .eyebrow,
  .hero-meta__label,
  .event-card__label,
  .about-card__label,
  .person-card__role {
    display: inline-block;

    margin: 0 0 .9rem;

    text-transform: uppercase;

    letter-spacing: .12em;

    font-size: .76rem;
    font-weight: 800;

    color: var(--brand-dark);
  }

  .eyebrow--light {
    color: rgba(255,255,255,.82);
  }

  .hero-copy h1,
  .hero-frame__overlay h2,
  .section-heading h2 {
    margin: 0;

    font-family:
      'Iowan Old Style',
      'Georgia',
      serif;

    color: var(--ink);

    letter-spacing: -.06em;
  }

  .hero-copy h1 {
    font-size:
      clamp(4.5rem, 8vw, 9rem);

    max-width: 10ch;

    line-height: .88;

    text-wrap: balance;
  }

  .hero-copy__lead,
  .hero-frame__overlay p,
  .section-intro,
  .about-card p,
  .event-card__body p,
  .past-card__body span,
  .person-card__body p,
  .faq-item p,
  .resource-card p,
  .site-footer p {
    margin: 0;

    color: var(--muted);

    line-height: 1.75;
  }

  .hero-copy__lead {
    max-width: 48rem;

    margin-top: 1.5rem;

    font-size: 1.18rem;
  }

  .hero-actions,
  .hero-meta,
  .person-card__socials,
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-actions {
    margin-top: 2rem;
  }

  .hero-meta {
    margin-top: 2rem;
  }

  .hero-meta div {
    padding:
      1rem
      1.2rem;

    border:
      1px solid var(--border);

    border-radius: 18px;

    background:
      rgba(255,255,255,.72);

    backdrop-filter: blur(12px);
  }

  .hero-media {
    display: grid;

    grid-template-columns:
      minmax(0, 1.2fr)
      minmax(320px, .8fr);

    align-items: stretch;

    gap: 1.25rem;
  }

  .hero-frame {
    position: relative;

    min-height: 52rem;

    border-radius: 32px;

    overflow: hidden;

    border:
      1px solid rgba(255,255,255,.45);

    background:
      linear-gradient(180deg, rgba(9,8,8,.08), rgba(9,8,8,.42)),
      radial-gradient(circle at 16% 18%, rgba(255,255,255,.18), transparent 18%),
      radial-gradient(circle at 74% 22%, rgba(255,211,133,.24), transparent 22%),
      linear-gradient(135deg, #61493b 0%, #9f7450 44%, #d9bf97 100%);

    box-shadow:
      0 35px 90px rgba(31,27,23,.14);
  }

  .hero-frame__overlay {
    position: absolute;

    left: 2rem;
    right: 2rem;
    bottom: 2rem;

    max-width: 36rem;

    z-index: 1;

    color: white;
  }

  .hero-frame__overlay h2 {
    color: white;

    font-size:
      clamp(2.8rem, 4vw, 4.8rem);

    line-height: .92;

    max-width: 12ch;
  }

  .hero-rail {
    display: grid;
    gap: 1rem;
  }

  .hero-thumb {
    display: grid;

    grid-template-columns:
      minmax(120px, 160px)
      1fr;

    align-items: center;

    min-height: 180px;

    gap: 1rem;

    padding: 1rem;

    border:
      1px solid var(--border);

    border-radius: 22px;

    background:
      rgba(255,255,255,.74);

    backdrop-filter: blur(10px);
  }

  .hero-thumb__image {
    position: relative;

    overflow: hidden;

    height: 100%;

    border-radius: 18px;
  }

  .hero-thumb__copy strong {
    font-size: 1.15rem;
    line-height: 1.2;
  }

  .about-section,
  .events-section,
  .gallery-section,
  .team-section,
  .faq-section,
  .resources-section {
    scroll-margin-top: 7rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;

    margin-bottom: 2rem;
  }

  .section-heading--split {
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(300px, .9fr);

    align-items: end;
  }

  .section-heading h2 {
    font-size:
      clamp(2.5rem, 5vw, 4.5rem);

    max-width: 12ch;

    line-height: .95;
  }

  .about-card,
  .event-card,
  .past-card,
  .person-card,
  .faq-item,
  .resource-card {
    border:
      1px solid var(--border);

    border-radius: 24px;

    background:
      rgba(255,255,255,.74);

    backdrop-filter: blur(10px);
  }

  .upcoming-grid,
  .resource-grid,
  .team-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0,1fr));

    gap: 1.5rem;
  }

  .gallery-grid {
    display: grid;

    grid-template-columns:
      1.2fr .9fr .9fr;

    gap: 1.5rem;

    grid-auto-rows: 14rem;
  }

  .site-footer {
    margin-top: 5rem;

    padding:
      2rem
      0;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    border-top:
      1px solid var(--border);
  }

  @media (max-width: 1160px) {

    .hero-section,
    .section-heading--split,
    .about-grid,
    .gallery-grid,
    .upcoming-grid,
    .team-grid,
    .resource-grid {
      grid-template-columns: 1fr;
    }

    .hero-media {
      grid-template-columns: 1fr;
    }

    .hero-frame {
      min-height: 36rem;
    }

    .hero-rail {
      grid-template-columns:
        repeat(3, minmax(0,1fr));
    }
  }

  @media (max-width: 860px) {

    .site-header,
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-nav {
      justify-content: flex-start;
    }

    .hero-copy h1 {
      font-size:
        clamp(3.5rem, 12vw, 6rem);

      max-width: none;
    }

    .hero-rail {
      grid-template-columns: 1fr;
    }

    .hero-thumb {
      grid-template-columns:
        minmax(110px,140px)
        1fr;
    }
  }

  @media (max-width: 640px) {

    .proposal-site {
      padding-inline: 1rem;
    }

    .site-main {
      gap: 5rem;
    }

    .hero-section {
      padding-top: 2rem;
    }

    .hero-frame {
      min-height: 24rem;
      border-radius: 24px;
    }

    .hero-frame__overlay {
      left: 1rem;
      right: 1rem;
      bottom: 1rem;
    }

    .hero-thumb {
      min-height: 140px;
    }

    .event-card {
      grid-template-columns: 1fr;
    }
  }
</style>
</BaseLayout>