import InitiativesSection from '../components/sections/InitiativesSection.astro';
import BlogSection from '../components/sections/BlogSection.astro';
import LeadershipSection from '../components/sections/LeadershipSection.astro';
---

<PageLayout
  title="Comunidade Python"
  description="Empoderando mulheres em tecnologia através do Python na cidade da Beira, Moçambique."
>
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <HeroSection />
