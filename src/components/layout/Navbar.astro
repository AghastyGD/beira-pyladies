---
import { navigation } from '../../constants/navigation';
import MobileMenu from './MobileMenu.astro';

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
};

const linkBase =
  'py-2 border-b-2 border-transparent transition-all duration-300 ease-in-out hover:text-primary dark:hover:text-primary-fixed-dim';
---

<header
  class="bg-surface dark:bg-surface-dim border-b border-outline-variant dark:border-outline sticky top-0 z-40"
>
  <div
    class="flex justify-between items-center gap-3 md:gap-4 px-margin-mobile md:px-margin-desktop py-unit max-w-container-max mx-auto h-20"
  >
    <div class="flex items-center gap-3 md:gap-4 min-w-0">
      <button
        id="mobile-menu-button"
        type="button"
        class="lg:hidden text-primary cursor-pointer bg-transparent border-0 p-0 leading-none"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="material-symbols-outlined" aria-hidden="true">menu</span>
      </button>

      <a
        href="/"
        class="font-display-lg text-headline-sm md:text-headline-md text-primary dark:text-primary-fixed-dim tracking-tight whitespace-nowrap"
      >
        PyLadies Beira
      </a>
    </div>

    <nav class="hidden lg:flex gap-8 items-center" aria-label="Navegação principal">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              linkBase,
              isActive(item.href)
                ? 'text-primary dark:text-primary-fixed-dim font-bold border-primary'
                : 'text-on-surface-variant dark:text-on-surface',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <a
        href="/community"
        class="inline-flex items-center justify-center bg-primary text-on-primary px-4 py-2.5 lg:px-8 lg:py-3 font-label-md hover:opacity-80 transition-opacity rounded-lg"
      >
        Aderir
      </a>
    </div>
  </div>

  <MobileMenu />
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const icon = button?.querySelector('.material-symbols-outlined');

  const setMenuState = (open: boolean) => {
    if (!button || !menu) return;

    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    menu.classList.toggle('hidden', !open);

    if (icon) icon.textContent = open ? 'close' : 'menu';
  };

  button?.addEventListener('click', () => {
    setMenuState(button.getAttribute('aria-expanded') !== 'true');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });
</script>
